# Copy this file to .env (local dev) and set the same keys in
# Vercel → Project → Settings → Environment Variables for Production/Preview.
# Values are secrets — never commit the real .env file.

# --- Supabase ---
# Project URL and anon/publishable key: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Service role key: Supabase dashboard → Project Settings → API → service_role secret.
# Server-only — used by the /api serverless functions to bypass RLS. Do NOT prefix
# with VITE_ or it would be bundled into the client build.
SUPABASE_SERVICE_ROLE_KEY=

# --- Wompi (El Salvador) ---
# From your Wompi merchant portal: Aplicativos → your app → API credentials.
# Use a test (sandbox) app first; switch to the production app's keys to go live.
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=

# "test" while using sandbox credentials, "production" with the live ones.
# In production the webhook refuses sandbox transactions (EsProductiva: false),
# so a test payment can never mark real rent as paid.
WOMPI_MODE=test

# Public https origin of the deployed app, e.g. https://nextspace.vercel.app
# (no trailing slash). Wompi sends the payment confirmation to
# $PUBLIC_BASE_URL/api/wompi/webhook and returns the tenant to the dashboard,
# so it cannot be localhost — use the Vercel URL or a tunnel (ngrok) locally.
PUBLIC_BASE_URL=

# --- Rony AI advisor ---
GEMINI_API_KEY=
